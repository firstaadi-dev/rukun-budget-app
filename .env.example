# Salin ke .env untuk menjalankan di lokal (lihat README).
DATABASE_URL=postgres://localhost:5432/rukun?sslmode=disable
BASE_CURRENCY=IDR
APP_TZ=Asia/Jakarta
PORT=8080
APP_URL=http://localhost:8080
# Ambil apiKey dan projectId dari konfigurasi Firebase Web App.
# firebaseconfig.json lokal diabaikan Git; di Render isi dua env var ini.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Token API admin. Kosong berarti API admin mati.
ADMIN_TOKEN=ganti-token-ini
# Kunci Twelve Data, sumber harga pasar ketiga. Dipakai saat Yahoo membalas
# 429 — batasnya per akun, bukan per alamat IP. Daftar gratis di
# twelvedata.com/pricing. Kosong berarti sumber itu mati.
HARGA_TWELVE_KEY=
