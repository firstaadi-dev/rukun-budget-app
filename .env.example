# Salin ke .env untuk menjalankan di lokal (lihat README).
DATABASE_URL=postgres://localhost:5432/rukun?sslmode=disable
BASE_CURRENCY=IDR
APP_TZ=Asia/Jakarta
PORT=8080
# Token API admin. Kosong berarti API admin mati dan keluarga baru
# tidak bisa dibuat. Lihat README bagian "Membuat keluarga baru".
ADMIN_TOKEN=ganti-token-ini
